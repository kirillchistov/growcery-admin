NEXT_PUBLIC_SERVER_URL=http://localhost:3000 
NEXT_PUBLIC_APP_NAME=Growcery
NEXT_PUBLIC_APP_DESCRIPTION=Growcery NextJS 15 Admin Dashboard
ITEMS_PER_PAGE=5

# Copy from .env.local on the Vercel dashboard
